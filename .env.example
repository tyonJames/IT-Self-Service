# =============================================================================
# Radx IT Help Desk — environment configuration
# =============================================================================
# Copy to `.env` for local development. NEVER commit a real `.env`.
# In Azure these are set as App Service Application Settings, with the secret
# ones sourced from Key Vault via @Microsoft.KeyVault(...) references.
# See AZURE_DEPLOYMENT.md §8 and §9.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# Required in every environment. 50+ random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=change-me-to-at-least-fifty-random-characters-before-you-deploy
# Comma-separated. Enforced by middleware in production.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated absolute origins allowed to POST (CSRF origin check).
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Public base URL — used in emails and confirmation links.
APP_BASE_URL=http://localhost:3000
PORT=3000

# --- Database ---------------------------------------------------------------
# Azure: postgresql://USER:PASS@SERVER.postgres.database.azure.com:5432/helpdesk?sslmode=require
DATABASE_URL=postgresql://radx:radx@127.0.0.1:5432/radx_helpdesk
# Used only by the integration test suite.
TEST_DATABASE_URL=postgresql://radx:radx@127.0.0.1:5432/radx_helpdesk_test

# --- Email (SMTP) -----------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=groupit@radxconstruction.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Radx IT Help Desk <groupit@radxconstruction.com>
# Where new-ticket alerts go. Comma-separated.
IT_NOTIFY_EMAILS=groupit@radxconstruction.com
# console = write emails to stdout instead of sending (development default)
EMAIL_BACKEND=console

# --- Cache / rate limiting --------------------------------------------------
# Leave blank to use the in-process limiter (development / single instance only).
# Azure Cache for Redis: rediss://:PASSWORD@NAME.redis.cache.windows.net:6380
REDIS_URL=

# --- File storage -----------------------------------------------------------
# local | azure
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./.storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=helpdesk-uploads
# Leave the connection string blank in Azure and rely on Managed Identity.
AZURE_STORAGE_CONNECTION_STRING=
MAX_UPLOAD_BYTES=10485760

# --- Security ---------------------------------------------------------------
# Fernet key, 32 url-safe-base64-encoded bytes. REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FIELD_ENCRYPTION_KEY=
ADMIN_URL=secret-admin-path
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
IP_MAX_ATTEMPTS=20
IP_LOCKOUT_SECONDS=900
PASSWORD_MIN_LENGTH=12
PASSWORD_RESET_MAX_PER_WINDOW=5
PASSWORD_RESET_WINDOW_SECONDS=900
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
PUBLIC_FORM_MAX_PER_WINDOW=10
PUBLIC_FORM_WINDOW_SECONDS=3600
IMPORT_MAX_PER_WINDOW=5
IMPORT_WINDOW_SECONDS=3600
# Shared secret for the scheduled-job HTTP trigger (recycle-bin purge, retries).
JOB_TRIGGER_SECRET=

# --- Session ----------------------------------------------------------------
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# --- Support contact (shown on login and help pages) ------------------------
SUPPORT_PHONE=+263 000 000 000
SUPPORT_WHATSAPP=263000000000
SUPPORT_EMAIL=it@radxconstruction.com

# --- Working hours (SLA calculation) ----------------------------------------
WORK_DAY_START=8
WORK_DAY_END=17
WORK_DAYS=0,1,2,3,4
WORK_TIMEZONE=Africa/Harare

# --- Transport security -----------------------------------------------------
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# --- Device tracking --------------------------------------------------------
# IP geolocation endpoint; {ip} is substituted. Blank disables geo lookup.
GEOIP_ENDPOINT=https://ipapi.co/{ip}/json/
GEOIP_TIMEOUT_MS=2500

# --- Observability ----------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_LEVEL=info

# --- Recycle bin ------------------------------------------------------------
RECYCLE_BIN_RETENTION_DAYS=30
